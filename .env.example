# Solo desarrollo local. Copiar como .env y completar la clave.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omitir DATABASE_URL para usar SQLite local.
# DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/turno

# Vercel: definir en el panel, nunca subir un .env real.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-proyecto.vercel.app
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

