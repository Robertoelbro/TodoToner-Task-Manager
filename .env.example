# Solo desarrollo local. Copiar como .env y completar la clave.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omitir DATABASE_URL para usar SQLite local.
# DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/turno

# Vercel: definir en el panel, nunca subir un .env real.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-proyecto.vercel.app
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Google OAuth 2.0, cliente de tipo Aplicación web. Nunca subir credenciales reales.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opcional; si se define debe coincidir exactamente con el dominio de esta instancia.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/login/google/callback/
